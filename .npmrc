# NPM Configuration
# Set custom npm settings

# Registry
registry=https://registry.npmjs.org/

# Authentication
# Uncomment and set your token for private packages
# //registry.npmjs.org/:_authToken=${NPM_TOKEN}

# Package settings
save-exact=false
save-prefix=^

# Performance
fetch-timeout=60000
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Audit
audit-level=moderate

# Scripts
script-shell=/bin/bash

# Strict mode
strict-peer-dependencies=true

# Legacy settings (if needed for older packages)
# legacy-peer-deps=true
